# .env.example - Copy this to .env.local and fill in your values
# API Keys - Use server-side only for sensitive keys
# Powers /api/directions (Barikoi v2 routing, foot profile)
BARIKOI_API_KEY=your_api_key_here
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Public Configuration (safe to expose)
# Map style key for MapView. NEXT_PUBLIC_ values ship in the client bundle by
# design: use a dedicated domain-restricted, quota-capped key here and never
# reuse the server-only routing key above.
NEXT_PUBLIC_BARIKOI_API_KEY=your_map_style_key_here
NEXT_PUBLIC_BARIKOI_BASE_URL=https://barikoi.com/api
NEXT_PUBLIC_TILESERVER_URL=https://tiles.bmapsbd.com
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.bmapsbd.com/styles/planet_map.json
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key_here
NEXT_PUBLIC_DEFAULT_LAT=21.4225
NEXT_PUBLIC_DEFAULT_LON=39.8262
NEXT_PUBLIC_DEFAULT_ZOOM=15

# 3D Masjid Al-Haram model
# URL the browser fetches (same-origin proxy path avoids CORS on the LAN server)
NEXT_PUBLIC_3D_MODEL_URL=/models/Masjid_Al-Haram_Mecca_With_Expansion.glb
# Server-side upstream the Next proxy forwards /models/* to (NOT NEXT_PUBLIC_)
MODEL_UPSTREAM_URL=http://192.168.1.200:8000
